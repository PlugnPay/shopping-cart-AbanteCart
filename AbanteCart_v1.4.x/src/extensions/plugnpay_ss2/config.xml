<?xml version="1.0"?>
<extension>
	<id>plugnpay_ss2</id>
	<version>1.0.0</version>
	<type>payment</type>
	<category>payment</category>
	<cartversions>
		<item>1.4</item>
	</cartversions>
	<layout></layout>
	<priority>10</priority>
	<settings>
		<item id="plugnpay_ss2_login">
			<type required="true">input</type>
			<default_value></default_value>
		</item>
		<item id="plugnpay_ss2_currency">
			<type>selectbox</type>
			<variants>
				<item>USD</item>
				<item>CAD</item>
				<item>GBP</item>
				<item>EUR</item>
				<item>AUD</item>
				<item>NZD</item>
			</variants>
			<default_value>USD</default_value>
		</item>
		<item id="plugnpay_ss2_store_data">
			<type>selectbox</type>
			<variants>
				<item>1</item>
				<item>0</item>
			</variants>
			<default_value>1</default_value>
		</item>
		<item id="plugnpay_ss2_debugging">
			<type>selectbox</type>
			<variants>
				<item>0</item>
				<item>1</item>
			</variants>
			<default_value>0</default_value>
		</item>
		<item id="plugnpay_ss2_location_id">
			<type>selectbox</type>
			<variants>
				<item>0</item>
				<data_source>
					<model_rt>localisation/location</model_rt>
					<method>getLocations</method>
				</data_source>
				<fields>
					<field>location_id</field>
					<field>name</field>
				</fields>
			</variants>
		</item>
	</settings>
	<note>true</note>
	<help_link><![CDATA[https://docs.plugnpay.com/]]></help_link>
	<install>
		<sql>install.sql</sql>
		<trigger></trigger>
	</install>
	<uninstall>
		<sql>uninstall.sql</sql>
		<trigger></trigger>
	</uninstall>
</extension>
